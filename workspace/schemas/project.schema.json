{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace Project Manifest",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "status",
    "repository",
    "stack",
    "default_skills",
    "tools",
    "verification",
    "docs"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "idea",
        "research",
        "requirements",
        "architecture",
        "design",
        "implementation",
        "qa",
        "review",
        "deployment",
        "maintenance",
        "paused",
        "archived"
      ]
    },
    "repository": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Repository",
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "stack": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Stack",
      "type": "object",
      "required": [
        "frontend",
        "backend",
        "database",
        "infrastructure"
      ],
      "properties": {
        "frontend": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "backend": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "database": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "infrastructure": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "default_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "docs": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Document pointers",
      "type": "object",
      "required": [
        "overview",
        "rules",
        "requirements",
        "architecture",
        "design",
        "decisions",
        "tasks",
        "roadmap",
        "memory",
        "context_index",
        "client_brief",
        "sources",
        "handoff"
      ],
      "properties": {
        "overview": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "design": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "string",
          "minLength": 1
        },
        "roadmap": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        },
        "context_index": {
          "type": "string",
          "minLength": 1
        },
        "client_brief": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "string",
          "minLength": 1
        },
        "handoff": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
